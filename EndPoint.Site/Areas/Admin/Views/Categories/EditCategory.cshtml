@{
    ViewData["Title"] = "AddNewCategory";
    Layout = "~/Areas/Admin/Views/Shared/_Adminlayout.cshtml";
}
@using Store.Application.Services.Products.Commands.EditCategory
@model List<CategoriesrDto>

<section class="basic-elements">

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title-wrap bar-success">
                        <h4 class="card-title mb-0">اضافه کردن دسته بندی جدید برای محصولات</h4>
                    </div>
                </div>
                <div class="card-body">
                    <div class="px-3">
                        <div class="form">
                            <div class="form-body">
                                <div class="row">
                                    <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <input type="hidden" id="CategoryId" value="@ViewBag.CategoryId"/> 
                                            <label for="basicInput">نام دسته بندی</label>
                                            <input type="text" class="form-control" id="Name" value="@ViewBag.Name">
                                            <label for="basicInput">نام دسته بندی پدر</label>
                                            <select id="ParentCategoryId" name="ParentCategoryId"  class="form-control">
                                                <option value="">_</option>
                                                @foreach(var item in Model)
                                                {
                                                    <option value="@item.Id">@item.Name</option>
                                                }
                                            </select>
                                        </fieldset>
                                    </div>

                                    <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <br />
                                            <a onclick="EditCategory()" class="btn btn-success col-md-12">ویرایش دسته بندی</a>

                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>




@section Scripts
{

    <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Sweetalert2/sweetalert2.min.js"></script>


    <script>
        // متغیرهایی برای ذخیره مقادیر اولیه
        var originalName = "";
        var originalParentId = "";

        // هنگام لود شدن صفحه، مقادیر اولیه را ذخیره می‌کنیم
        $(document).ready(function () {
            originalName = $("#Name").val().trim();
            originalParentId = $("#ParentCategoryId").val();
        });

        function EditCategory() {
            // ۱. دریافت مقادیر فعلی
            var Id = $("#CategoryId").val();
            var Name = $("#Name").val().trim();
            var parentId = $("#ParentCategoryId").val();

            // یکسان سازی مقدار نال برای مقایسه راحت‌تر
            var currentParentId = (parentId === "") ? null : parentId;
            var initialParentId = (originalParentId === "") ? null : originalParentId;

            // ۲. بررسی خالی بودن نام دسته‌بندی
            if (!Name) {
                swal.fire('هشدار!', 'لطفاً نام دسته بندی را وارد کنید.', 'warning');
                return;
            }

            // ۳. بررسی اینکه آیا اصلاً تغییری ایجاد شده است یا خیر
            if (Name === originalName && currentParentId === initialParentId) {
                swal.fire('توجه!', 'هیچ تغییری در اطلاعات ایجاد نشده است.', 'info');
                return;
            }

            // ۴. اگر اطلاعات درست بود و تغییری داشتیم، سوال تایید پرسیده می‌شود
            swal.fire({
                title: 'ویرایش دسته بندی',
                text: "آیا میخواهید این دسته بندی را ویرایش کنید؟",
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'بله ویرایش شود.',
                cancelButtonText: 'خیر'
            }).then((result) => {
                if (result.value) {

                    var postData = {
                        'Id': Id,
                        'Name': Name,
                        'ParentId': currentParentId
                    };

                    $.ajax({
                        contentType: 'application/x-www-form-urlencoded',
                        dataType: 'json',
                        type: "POST",
                        url: "EditCategory",
                        data: postData,
                        success: function (data) {
                            if (data.isSuccess == true) {
                                swal.fire(
                                    'موفق!',
                                    data.message,
                                    'success'
                                ).then(function (isConfirm) {
                                    location.reload();
                                });
                            }
                            else {
                                swal.fire(
                                    'هشدار!',
                                    data.message,
                                    'warning'
                                );
                            }
                        },
                        error: function (request, status, error) {
                            swal.fire(
                                'خطا!',
                                request.responseText,
                                'error'
                            );
                        }
                    });
                }
            });
        }
    </script>

}


