@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AddNewProduct";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="basic-elements">
    <div class="row">
        <div class="col-sm-12">
            <h2 class="content-header">ایجاد محصول جدید</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title-wrap bar-success">
                        <h4 class="card-title mb-0">اطلاعات کاربر جدید را وارد نمایید</h4>
                    </div>
                </div>
                <div class="card-body">
                    <div class="px-3">
                        <div class="form">
                            <div class="form-body">
                                <div class="row">
                                    <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <label for="basicInput">نام محصول </label>
                                            <input type="text" class="form-control" id="Name">
                                        </fieldset>
                                    </div>
                                    <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <label for="basicInput"> برند </label>
                                            <input type="text" class="form-control" id="Brand">
                                        </fieldset>
                                    </div>
                                    <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <label for="basicInput"> قیمت</label>
                                            <input type="number" class="form-control" id="Price">
                                        </fieldset>
                                    </div>
                                    <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <label for="basicInput"> تعداد موجودی</label>
                                            <input type="number" class="form-control" id="Inventory">
                                        </fieldset>
                                    </div>
                                    <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <label for="basicInput">نمایش داده شود؟ </label>
                                            <input type="checkbox" class="form-control" id="Displayed">
                                        </fieldset>
                                    </div>
                                    <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <label for="basicInput">تصاویر </label>
                                            <input type="file" multiple class="form-control" accept="image/*" id="Images">
                                        </fieldset>
                                    </div>


                                    <div class="col-xl-4 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <label for="basicInput">دسته بندی </label>
                                            <select class="form-control" id="Category" asp-items="@ViewBag.Categories"></select>
                                        </fieldset>
                                    </div>
                                    <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <label for="basicInput"> توضیحات</label>
                                            <textarea id="Description" class="form-control " rows="5"></textarea>
                                        </fieldset>
                                    </div>

                                    <hr />
                                    <hr />




                                    <div class="col-xl-2 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <label for="basicInput"> نام ویژگی </label>
                                            <input type="text" class="form-control" id="txtDisplayName" placeholder="نام ویژگی" />
                                        </fieldset>
                                    </div>

                                    <div class="col-xl-2 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <label for="basicInput"> مقدار ویژگی </label>
                                            <input type="text" class="form-control" id="txtValue" placeholder="مقدار ویژگی" />
                                        </fieldset>
                                    </div>
                                    <div class="col-xl-2 col-lg-6 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <br />
                                            <a class="btn btn-success" id="btnAddFeatures">افزودن</a>
                                        </fieldset>
                                    </div>



                                    <br class="clear"/>

                                    <table id="tbl_Features" class="col-md-12 table table-bordered table-hover  table-condensed table-responsive">
                                        <thead>
                                            <tr>
                                                <th>
                                                    نام ویژگی
                                                </th>
                                                <th>
                                                    مقدار ویژگی
                                                </th>
                                                <th>

                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>


                                    <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                                        <fieldset class="form-group">
                                            <br />
                                            <a id="btnAddProduct" class="btn btn-success col-md-12"> افزودن محصول  </a>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Sweetalert2/sweetalert2.min.js"></script>

    <script>
        $(document).ready(function () {

            // افزودن ویژگی به جدول
            $("#btnAddFeatures").on("click", function () {
                var txtDisplayName = $("#txtDisplayName").val().trim();
                var txtValue = $("#txtValue").val().trim();

                if (txtDisplayName === "" || txtValue === "") {
                    Swal.fire('هشدار!', "نام و مقدار ویژگی را باید وارد کنید.", 'warning');
                } else {
                    $('#tbl_Features tbody').append('<tr> <td>' + txtDisplayName + '</td>  <td>' + txtValue + '</td> <td> <a class="idFeatures btnDelete btn btn-danger"> حذف </a> </td> </tr>');
                    $("#txtDisplayName").val('');
                    $("#txtValue").val('');
                }
            });

            // حذف ویژگی از جدول
            $("#tbl_Features").on('click', '.idFeatures', function () {
                $(this).closest('tr').remove();
            });

            // دکمه افزودن محصول
            $('#btnAddProduct').on('click', function () {

                // دریافت و پاکسازی مقادیر اولیه
                var name = $("#Name").val().trim();
                var brand = $("#Brand").val().trim();
                var price = $("#Price").val();
                var inventory = $("#Inventory").val();
                var categoryId = $('#Category').val();
                var productImages = document.getElementById("Images");
                var description = $("#Description").val().trim();

                // --- اعتبارسنجی‌ها ---

                if (!name) {
                    Swal.fire('خطا!', 'لطفاً نام محصول را وارد نمایید.', 'error');
                    return;
                }

                if (!brand) {
                    Swal.fire('خطا!', 'لطفاً برند محصول را وارد نمایید.', 'error');
                    return;
                }

                if (!price || isNaN(price) || parseFloat(price) <= 0) {
                    Swal.fire('خطا!', 'لطفاً یک قیمت معتبر (بزرگتر از صفر) وارد نمایید.', 'error');
                    return;
                }

                if (!inventory || isNaN(inventory) || parseInt(inventory) < 0) {
                    Swal.fire('خطا!', 'لطفاً تعداد موجودی معتبر (بزرگتر یا مساوی صفر) وارد نمایید.', 'error');
                    return;
                }

                if (!categoryId) {
                    Swal.fire('خطا!', 'لطفاً دسته‌بندی را انتخاب نمایید.', 'error');
                    return;
                }

                if (!description) {
                    Swal.fire('خطا!', 'لطفاً توضیحات محصول را وارد نمایید.', 'error');
                    return;
                }

                if (productImages.files.length === 0) {
                    Swal.fire('خطا!', 'لطفاً حداقل یک تصویر برای محصول انتخاب نمایید.', 'error');
                    return;
                }
                var featureCount = $('#tbl_Features tr:gt(0)').length;
                if (featureCount === 0) {
                    Swal.fire('خطا!', 'لطفاً حداقل یک ویژگی برای محصول وارد نمایید.', 'error');
                    return;
                }
                // --- نمایش پیام تایید ---
                Swal.fire({
                    title: 'ثبت محصول',
                    text: "آیا از اطلاعات وارد شده و ثبت این محصول اطمینان دارید؟",
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'بله، محصول ثبت شود',
                    cancelButtonText: 'انصراف'
                }).then((result) => {
                    if (result.value) {

                        // آماده‌سازی داده‌ها برای ارسال
                        var data = new FormData();

                        data.append("Name", name);
                        data.append("Brand", brand);
                        data.append("Price", price);
                        data.append("Inventory", inventory);
                        data.append("Displayed", $("#Displayed").is(":checked"));
                        data.append("CategoryId", categoryId);
                        data.append("Description", description);

                        // افزودن تصاویر
                        for (var i = 0; i < productImages.files.length; i++) {
                            data.append('Images', productImages.files[i]);
                        }

                        // افزودن ویژگی‌ها
                        var dataFeaturesViewModel = $('#tbl_Features tr:gt(0)').map(function () {
                            return {
                                DisplayName: $(this.cells[0]).text().trim(), // استفاده از trim برای اطمینان
                                Value: $(this.cells[1]).text().trim(),
                            };
                        }).get();

                        $.each(dataFeaturesViewModel, function (i, val) {
                            data.append('Features[' + i + '].DisplayName', val.DisplayName);
                            data.append('Features[' + i + '].Value', val.Value);
                        });

                        // ارسال درخواست AJAX
                        $.ajax({
                            type: "POST",
                            url: "/Admin/Products/AddNewProduct",
                            contentType: false,
                            processData: false,
                            data: data,
                            success: function (response) {
                                if (response.isSuccess == true) {
                                    Swal.fire(
                                        'موفق!',
                                        response.message,
                                        'success'
                                    ).then(function () {
                                        location.reload();
                                    });
                                }
                                else {
                                    Swal.fire(
                                        'هشدار!',
                                        response.message,
                                        'warning'
                                    );
                                }
                            },
                            error: function (xhr) {
                                Swal.fire('خطا!', 'خطایی در ارتباط با سرور رخ داده است. (کد: ' + xhr.status + ')', 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
