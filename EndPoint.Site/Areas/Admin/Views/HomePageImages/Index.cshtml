@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Store.Application.Services.HomePage.Queries.GetHomePageImages;
@using Store.Domain.Entities.HomePage
@model List<HomePageImagesDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-wrapper">
    <div class="container-fluid">
        <section id="configuration">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title-wrap bar-success">
                                <h4 class="card-title">لیست عکس ها</h4>
                            </div>
                        </div>
                        <div class="card-body collapse show">
                            <div class="card-block card-dashboard">
                                <p class="card-text">عکس های صفحه اصلی فروشگاه</p>
                                <a href="~/admin/HomePageImages/add" class="btn btn-success mb-3">افزودن عکس جدید</a>

                                <div class="dataTables_wrapper container-fluid dt-bootstrap4">
                                    <div class="col-sm-12">
                                        <table class="table table-striped table-bordered zero-configuration dataTable">
                                            <thead>
                                                <tr role="row">
                                                    <th>پیش‌نمایش عکس</th>
                                                    <th>جایگاه عکس</th>
                                                    <th>آدرس لینک (URL)</th>
                                                    <th>سورس عکس (آدرس فایل)</th>
                                                    <th>عملیات</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr role="row" class="odd">
                                                        <td class="text-center align-middle">
                                                            <img src="~/@item.Src" alt="Slider Image" style="max-width: 150px; max-height: 100px; border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);" />
                                                        </td>

                                                        <td class="align-middle" dir="ltr" style="text-align:left;">@item.ImageLocation</td>

                                                        <td class="align-middle" dir="ltr" style="text-align:left;">@item.Link</td>

                                                        <td class="align-middle" dir="ltr" style="text-align:left;">@item.Src</td>

                                                        <td class="align-middle">
                                                            <button onclick="OpenEditModal('@item.Id', '@item.Src', '@item.Link', '@((int)item.ImageLocation)')" class="btn btn-primary ml-2">ویرایش</button>
                                                            <button onclick="Remove('@item.Id')" class="btn btn-danger">حذف</button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Modals
{
    <div class="modal fade" id="editImageModal" tabindex="-1" role="dialog" aria-labelledby="editImageModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <form id="editImageForm" enctype="multipart/form-data">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editImageModalLabel">ویرایش عکس</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="بستن">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="editImageId" name="Id" />

                        <div class="form-group">
                            <label for="currentImage">پیش‌نمایش عکس فعلی:</label><br />
                            <img id="currentImage" src="" alt="Current Image" style="max-width: 100%; max-height: 150px; border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);" />
                        </div>

                        <div class="form-group">
                            <label for="newImage">آپلود عکس جدید (در صورت نیاز):</label>
                            <input type="file" class="form-control-file" id="newImage" name="NewImage" accept="image/*" />
                        </div>

                        <div class="form-group">
                            <label for="editLink">لینک (URL):</label>
                            <input type="text" class="form-control" id="editLink" name="Link" />
                        </div>

                        <div class="form-group">
                            <label for="editImageLocation">جایگاه عکس:</label>
                            <select class="form-control" id="editImageLocation" name="ImageLocation" asp-items="@Html.GetEnumSelectList<ImageLocation>()"></select>
                        </div>

                        <div id="editMessage" class="text-danger"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">لغو</button>
                        <button type="submit" class="btn btn-success">ذخیره تغییرات</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts
{
    <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Sweetalert2/sweetalert2.min.js"></script>

     <script>
        function Remove(Id) {
            swal.fire({
                title: 'حذف اسلایدر',
                text: "آیا از حذف این عکس از اسلایدر مطمئن هستید؟",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'خیر'
            }).then((result) => {
                if (result.value) {
                    var postData = {
                        'Id': Id,
                    };

                    $.ajax({
                        contentType: 'application/x-www-form-urlencoded',
                        dataType: 'json',
                        type: "POST",
                        url: "Remove", 
                        data: postData,
                        success: function (data) {
                            if (data.isSuccess == true) {
                                swal.fire(
                                    'موفق!',
                                    data.message,
                                    'success'
                                ).then(function (isConfirm) {
                                    location.reload();
                                });
                            }
                            else {
                                swal.fire(
                                    'هشدار!',
                                    data.message,
                                    'warning'
                                );
                            }
                        },
                        error: function (request, status, error) {
                            swal.fire(
                                'خطا!',
                                request.responseText,
                                'error'
                            );
                        }
                    });
                }
            })
        }
    
        var originalData = {
            Id: null,
            Src: null,
            Link: null,
            ImageLocation: null
        };

        function OpenEditModal(id, src, link, imageLocation) {
            originalData.Id = id;
            originalData.Src = src;
            originalData.Link = link;
            originalData.ImageLocation = imageLocation;

            $('#editImageId').val(id);
            $('#editLink').val(link);
            $('#editImageLocation').val(imageLocation);

            $('#newImage').val(''); 
            $('#editMessage').text('');
            $('#editImageModal').modal('show');
        }

        $('#editImageForm').submit(function (e) {
            e.preventDefault();

            var id = $('#editImageId').val();
            var newLink = $('#editLink').val();
            var newImageLocation = $('#editImageLocation').val();
            var fileInput = document.getElementById('newImage');
            if (fileInput.files.length > 0) {
                formData.append("File", fileInput.files[0]);
            }

            var changes = {};

            
            if (newLink !== originalData.Link) {
                changes.Link = newLink;
            }
            if (newImageLocation !== originalData.ImageLocation) {
                changes.ImageLocation = newImageLocation;
            }
            if (newImageFile) {
                changes.NewImage = newImageFile; 
            }

            if (Object.keys(changes).length === 0) {
                $('#editMessage').text('هیچ تغییری انجام نشده است.');
                return;
            }

            var formData = new FormData();
            formData.append('Id', id);

            if (changes.Link !== undefined) formData.append('Link', changes.Link);
            if (changes.ImageLocation !== undefined) formData.append('ImageLocation', changes.ImageLocation);
            if (changes.NewImage !== undefined) formData.append('File', changes.NewImage);

            $.ajax({
                url: '/Admin/HomePageImages/Edit',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.isSuccess) {
                        Swal.fire(
                            'موفق',
                            data.message,
                            'success'
                        ).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire(
                            'هشدار',
                            data.message,
                            'warning'
                        );
                    }
                },
                error: function (xhr) {
                    Swal.fire(
                        'خطا',
                        xhr.responseText,
                        'error'
                    );
                }
            });
        });
    </script>
}







